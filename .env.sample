# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Binance Futures API credentials (only needed when DRY_RUN=false)
API_KEY=KEY
API_SECRET=SECRET
TESTNET=false
# Python logging level, e.g. DEBUG/INFO/WARNING/ERROR. Read by every entry point via
# core/logging_config.py. DEBUG adds a per-candle line (candle/action/status/indicators),
# which is ~1.4k lines a day on a 1m interval — useful when debugging a strategy, noisy
# for a process that is meant to run for weeks.
LOG_LEVEL=INFO
# DRY_RUN=true simulates fills locally and sends no orders. Keep it true until you
# have watched the strategy run and understand what it does with real money.
DRY_RUN=true

SYMBOLS=ETHUSDT,BTCUSDT
INTERVAL=1m
# Live-only decision deadline, in seconds after the candle close. A candle processed later
# than this (network delay, or waiting behind another symbol's gap backfill) still reaches the
# strategy, but market orders that would grow a position are dropped, because a backtest assumes
# a market order fills at the decision candle's close. Reducing orders, limit/stop orders and
# cancels still go out. Closed candles normally arrive within 0.2s. 0 disables it. Dry run
# ignores it, since it fills at the close regardless.
DECIDE_DEADLINE_S=3

# Strategy params, read by core/examples/trader.py (defaults are KeltnerStreamer's).
# Change these to match whichever streamer you wired up in trader.py.
WINDOW=4320
M_ENTRY=4.0
M_EXIT=3.0
# MAX_LOSS is the loss budget at the stop distance, and in practice the leverage knob.
# Raising it quickly pins leverage at the 6x cap — see README.
MAX_LOSS=0.005

# Result recording. Writes the live/dry run to <RESULT_PATH>/live/ in exactly the format
# the backtester writes to asset/backtest/, so the visualiser can load and compare both.
RECORD=true
# Relative to the process's working directory (/app in Docker), same rule as the backtester.
RESULT_PATH=asset/
# Fixing the run id makes a restart continue the same run instead of starting a fresh file —
# without it the curve fragments on every crash. Leave blank to derive it automatically as
# "<live|dry>_<Streamer>_<SYM1-SYM2-...>_<INTERVAL>" (symbols sorted, hyphen-joined). Changing
# strategy params or the symbol set forks a new run.
LIVE_RUN_ID=
# How often (in candles) the month's time-series shard is rewritten. Lower loses less on a
# crash but writes more; the run JSON itself is rewritten every candle regardless.
LIVE_SHARD_FLUSH_EVERY=60

# US equity candles (Massive, formerly Polygon.io) — backtest data only, unrelated to trading.
# Only needed if you use core/fetcher/stock/. The free Basic tier is enough.
MASSIVE_API_KEY=KEY
